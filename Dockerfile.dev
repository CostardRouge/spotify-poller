# Local development image: source is bind-mounted by docker-compose, so we
# only need dependencies (and the native toolchain for better-sqlite3) here.
FROM node:24-alpine

WORKDIR /app
RUN apk add --no-cache python3 make g++

# Install dependencies first for better layer caching.
COPY package.json package-lock.json* ./
RUN npm install

EXPOSE 3000
ENV NODE_ENV=development
ENV API_HOST=0.0.0.0
ENV DB_PATH=/data/life-events.db

# `exec` so the dev server — not sh — is PID 1 and receives docker stop's
# SIGTERM directly (sh does not forward signals; see the Dockerfile CMD).
CMD ["sh", "-c", "node_modules/.bin/tsx scripts/migrate.ts && exec node_modules/.bin/next dev -H 0.0.0.0 -p 3000"]
