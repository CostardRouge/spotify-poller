# =============================================================================
# Spotify Poller — environment configuration
# Copy this file to ".env" (make init does it for you), fill in the values,
# then: chmod 600 .env
# AUCUN de ces secrets ne doit finir dans une couche Docker — le fichier est
# monté/injecté au lancement (env_file), jamais copié dans l'image.
# =============================================================================

# --- Spotify app credentials -------------------------------------------------
# Create a free app at https://developer.spotify.com/dashboard (app SÉPARÉE de
# celle du Spotify Calendar) and copy its Client ID / Client Secret here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- OAuth redirect URI ------------------------------------------------------
# Must EXACTLY match a Redirect URI registered in your Spotify app settings.
# La connexion du compte se fait depuis l'UI (bouton « Connecter Spotify »).
#   Local dev:  http://127.0.0.1:8787/auth/callback
#   Home Lab:   http://<optiplex-ip-or-host>:8787/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/auth/callback

# --- Refresh token (fallback, optionnel) -------------------------------------
# Voie normale : bouton « Connecter Spotify » de l'UI (le token vit alors dans
# poller_state, sur le volume de données). Ce fallback env reste supporté pour
# l'installation historique via scripts/get-refresh-token.mjs.
# SPOTIFY_REFRESH_TOKEN=

# --- Watchdog externe (spec §9) — obligatoire en usage réel ------------------
# healthchecks.io : période 30 min, grâce 2 h. Seule protection contre un
# hôte entièrement éteint — le HEALTHCHECK Docker ne le remplace pas.
WATCHDOG_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Admin -------------------------------------------------------------------
# openssl rand -hex 32 — requis par l'UI de debug et les endpoints /run, /stats.
ADMIN_TOKEN=

# --- Host port ---------------------------------------------------------------
# Port published on the host. The app always listens on 8787 inside the
# container. UI de debug + API : réseau local uniquement.
APP_PORT=8787

# --- Scheduling (docs/scheduling.md) -----------------------------------------
# En Docker, la planification est interne au conteneur (les compose mettent
# SCHEDULE_ENABLED=1). En bare-metal, laisser désactivé : ce sont les timers
# systemd qui pilotent run-once.ts.
# SCHEDULE_ENABLED=1
# SCHEDULE_A_MINUTES=30
# SCHEDULE_B_HOURS=24

# --- Bare-metal only ---------------------------------------------------------
# Chemins/écoute hors Docker (les compose fixent leurs propres valeurs).
# DB_PATH=/opt/spotify-poller/data/life-events.db
# API_HOST=127.0.0.1
# API_PORT=8787
