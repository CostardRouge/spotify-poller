# =============================================================================
# Spotify Poller — environment configuration
# Copy this file to ".env" (make init does it for you), fill in the values,
# then: chmod 600 .env
# NONE of these secrets must end up in a Docker layer — the file is
# mounted/injected at launch (env_file), never copied into the image.
# =============================================================================

# --- Spotify app credentials -------------------------------------------------
# Create a free app at https://developer.spotify.com/dashboard (a SEPARATE app
# from the Spotify Calendar one) and copy its Client ID / Client Secret here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- OAuth redirect URI ------------------------------------------------------
# Must EXACTLY match a Redirect URI registered in your Spotify app settings.
# The account is connected from the UI ("Connect Spotify" button, /accounts).
#   Local dev:  http://127.0.0.1:3000/api/spotify/callback
#   Home Lab:   http://<optiplex-ip-or-host>:3000/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# --- Refresh token (fallback, optional) --------------------------------------
# Normal path: the UI's "Connect Spotify" button (the token then lives in the
# `accounts` table, on the data volume). This env fallback is still supported
# for the legacy install via scripts/get-refresh-token.mjs; on first use it is
# resolved against /v1/me and adopted into `accounts`.
# SPOTIFY_REFRESH_TOKEN=

# --- Heartbeat / dead man's switch (spec §9) — mandatory in real use ---------
# Alerts on SILENCE, which is the failure ntfy can never report: a poller that
# is dead sends nothing. Pinged after every successful A run.
#   healthchecks.io:  https://hc-ping.com/<uuid>       (30 min period, 2 h grace)
#   Uptime Kuma:      https://kuma.example.org/api/push/<id>
# The Uptime Kuma "Push" monitor uses the exact same contract and keeps the whole
# stack self-hosted — it can then notify your ntfy itself.
WATCHDOG_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- ntfy notifications (actionable alerts) ----------------------------------
# Full topic URL. Carries what needs a human: revoked token (reconnect the
# account), failed run, failed backup, detected gap. Complements the heartbeat,
# it does NOT replace it — see src/notify.ts.
# NTFY_URL=https://ntfy.example.org/spotify-poller
# NTFY_TOKEN=              # only for a protected topic
# NTFY_THROTTLE_HOURS=6    # max one alert of each kind per window (anti-spam)

# --- Admin / authentication --------------------------------------------------
# AUTH_MODE=token (default): ADMIN_TOKEN required on every admin route.
# AUTH_MODE=proxy: your reverse proxy authenticates (Cloudflare Access, Traefik
#   basic auth…) and the UI stops asking for a token. Set PROXY_AUTH_HEADER so a
#   request reaching the origin DIRECTLY — bypassing the proxy — is still
#   rejected; without it, anything that can reach the process is trusted.
# AUTH_MODE=proxy
# PROXY_AUTH_HEADER=Cf-Access-Authenticated-User-Email
#
# openssl rand -hex 32 — required in token mode, optional (but still honoured,
# which keeps local curl working) in proxy mode. This is the sign-in password
# for /login — it is checked once, then a JWT session cookie carries you.
ADMIN_TOKEN=

# openssl rand -hex 32 — signs the JWT session cookie /login mints after
# checking ADMIN_TOKEN. Deliberately a SEPARATE secret: a leaked session
# cookie must not also leak (or be derivable from) the login password.
JWT_SECRET=

# --- Backups -----------------------------------------------------------------
# The .db snapshot is written through SQLite's online backup API: consistent in
# WAL mode, no service interruption. It lands on a HOST bind mount, outside the
# data volume (docker-compose.prod.yml).
# WARNING: the .db contains the Spotify refresh token in clear — treat it like
# this file. For a secret-free dump, use the NDJSON export (make prod-export).
# BACKUP_ENABLED=1         # daily snapshot driven by the internal scheduler
# BACKUP_DIR=/backups
# BACKUP_KEEP=14           # snapshots kept before rotation
# BACKUP_EVERY_HOURS=24

# --- Host port ---------------------------------------------------------------
# Port published on the host. The app always listens on 3000 inside the
# container (Next.js default). Dashboard + API: local network only.
APP_PORT=3000

# --- Display timezone ---------------------------------------------------------
# IANA name (e.g. Europe/Paris). Display-only: every timestamp is stored and
# queried in UTC (ts_utc) regardless of this setting — this only controls how
# the debug UI renders them. Defaults to UTC if unset.
TIMEZONE=Europe/Paris

# --- Scheduling (docs/scheduling.md) -----------------------------------------
# Under Docker, scheduling is internal to the container (the compose files set
# SCHEDULE_ENABLED=1). On bare metal, leave it disabled: the systemd timers are
# what drive run-once.ts.
# The two collectors are named after what they collect: 'played'
# (recently-played) and 'liked' (liked tracks).
# SCHEDULE_ENABLED=1
# SCHEDULE_PLAYED_MINUTES=30
# SCHEDULE_LIKED_HOURS=24

# --- Playback collector (opt-in bonus) ---------------------------------------
# Polls GET /me/player to record WHICH DEVICE a track played on, at what volume,
# from which playlist, and whether it was finished or skipped. It COMPLEMENTS
# 'played' (which stays the authoritative history and back-fills across
# downtime) — it never replaces it, and it only sees what happens while the
# process is up.
# Requires the extra scope 'user-read-playback-state': after enabling this, the
# UI raises a banner until you reconnect the account.
# Needs SCHEDULE_ENABLED=1 — sub-minute polling cannot be driven by a systemd
# timer, so this stays off on bare-metal installs.
# PLAYBACK_ENABLED=1
# PLAYBACK_POLL_SECONDS=15          # cadence while something is playing
# PLAYBACK_IDLE_POLL_SECONDS=60     # cadence once idle
# PLAYBACK_IDLE_AFTER=4             # consecutive idle polls before slowing down
# PLAYBACK_RETENTION_DAYS=30        # purge of playback_samples (sessions are kept)

# --- Bare-metal only ---------------------------------------------------------
# Paths/listen address outside Docker (the compose files set their own values).
# DB_PATH=/opt/spotify-poller/data/life-events.db
# API_HOST=127.0.0.1
# API_PORT=3000
