# =============================================================================
# Spotify Poller — environment configuration
# Copy this file to ".env" (make init does it for you), fill in the values,
# then: chmod 600 .env
# NONE of these secrets must end up in a Docker layer — the file is
# mounted/injected at launch (env_file), never copied into the image.
# =============================================================================

# --- Spotify app credentials -------------------------------------------------
# Create a free app at https://developer.spotify.com/dashboard (a SEPARATE app
# from the Spotify Calendar one) and copy its Client ID / Client Secret here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- OAuth redirect URI ------------------------------------------------------
# Must EXACTLY match a Redirect URI registered in your Spotify app settings.
# The account is connected from the UI ("Connect Spotify" button).
#   Local dev:  http://127.0.0.1:8787/auth/callback
#   Home Lab:   http://<optiplex-ip-or-host>:8787/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/auth/callback

# --- Refresh token (fallback, optional) --------------------------------------
# Normal path: the UI's "Connect Spotify" button (the token then lives in
# poller_state, on the data volume). This env fallback is still supported for
# the legacy install via scripts/get-refresh-token.mjs.
# SPOTIFY_REFRESH_TOKEN=

# --- External watchdog (spec §9) — mandatory in real use ---------------------
# healthchecks.io: 30 min period, 2 h grace. The only protection against a
# fully powered-off host — the Docker HEALTHCHECK does not replace it.
WATCHDOG_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Admin -------------------------------------------------------------------
# openssl rand -hex 32 — required by the debug UI and the /run, /stats endpoints.
ADMIN_TOKEN=

# --- Host port ---------------------------------------------------------------
# Port published on the host. The app always listens on 8787 inside the
# container. Debug UI + API: local network only.
APP_PORT=8787

# --- Scheduling (docs/scheduling.md) -----------------------------------------
# Under Docker, scheduling is internal to the container (the compose files set
# SCHEDULE_ENABLED=1). On bare metal, leave it disabled: the systemd timers are
# what drive run-once.ts.
# SCHEDULE_ENABLED=1
# SCHEDULE_A_MINUTES=30
# SCHEDULE_B_HOURS=24

# --- Bare-metal only ---------------------------------------------------------
# Paths/listen address outside Docker (the compose files set their own values).
# DB_PATH=/opt/spotify-poller/data/life-events.db
# API_HOST=127.0.0.1
# API_PORT=8787
