{
  "name": "Témoin",
  "short_name": "Témoin",
  "description": "Custody report for a personal Spotify listening history: proves collection is running, surfaces gaps, lets the operator browse and export what was collected.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f2eee4",
  "theme_color": "#f2eee4",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Trace", "description": "Every day as the pen drew it, gaps declared", "url": "trace", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Gaps", "description": "Windows the poller knows it did not cover", "url": "gaps", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Runs", "description": "Every collection attempt, successful or not", "url": "runs", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Events", "description": "Everything collected, filterable and exportable", "url": "events", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
