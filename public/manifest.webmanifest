  "shortcuts": [
    { "name": "Trace", "description": "Every day as the pen drew it, gaps declared", "url": "trace", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Journal", "description": "Every collection attempt, and every window the poller knows it missed", "url": "journal", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "System", "description": "What runs the instrument, and what is left to set up", "url": "system", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Library", "description": "Everything collected, filterable and exportable", "url": "events", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
