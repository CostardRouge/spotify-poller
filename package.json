{
  "name": "spotify-poller",
  "version": "2.3.0",
  "private": true,
  "description": "Continuously and unattended, collects the listening history (and likes) of a personal Spotify account into a local SQLite database.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H ${API_HOST:-127.0.0.1} -p ${API_PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "node ./node_modules/typescript7/bin/tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "migrate": "tsx scripts/migrate.ts",
    "run:played": "tsx scripts/run-once.ts played",
    "run:liked": "tsx scripts/run-once.ts liked",
    "run:artists": "tsx scripts/run-once.ts artists",
    "backup": "tsx scripts/backup.ts",
    "export": "tsx scripts/export.ts",
    "import": "tsx scripts/import.ts",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^18.0.2",
    "jose": "^6.2.12",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.0.2"
  }
}
