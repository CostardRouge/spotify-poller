[Unit]
Description=Spotify Poller — collector 'liked' (liked-tracks)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/spotify-poller
EnvironmentFile=/opt/spotify-poller/.env
ExecStart=/opt/spotify-poller/node_modules/.bin/tsx scripts/run-once.ts liked
User=poller
Group=poller
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/spotify-poller/data
PrivateTmp=true
