[Unit]
Description=Collector 'played' cadence (every 30 min, spec §3)

[Timer]
OnCalendar=*:0/30
# If the OptiPlex was off/rebooting at the scheduled time (update, outage
# beyond the UPS window), we catch up at startup rather than waiting for the
# next slot — this bounds the loss window defined in §1.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
