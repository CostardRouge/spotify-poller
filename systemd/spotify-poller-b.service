[Unit]
Description=Spotify Poller — collector B (liked-tracks)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/spotify-poller
EnvironmentFile=/opt/spotify-poller/.env
ExecStart=/usr/bin/node dist/run-once.js B
User=poller
Group=poller
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/spotify-poller/data
PrivateTmp=true
