[Unit]
Description=Spotify Poller — collector A (recently-played, critical)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/spotify-poller
EnvironmentFile=/opt/spotify-poller/.env
ExecStart=/usr/bin/node dist/run-once.js A
User=poller
Group=poller
# Defence in depth, with no impact on the business logic:
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/spotify-poller/data
PrivateTmp=true
